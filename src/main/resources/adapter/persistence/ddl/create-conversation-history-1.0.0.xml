<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">


    <changeSet id="006-create-conversation-history" author="hirannor">

        <createSequence
                sequenceName="conversation_seq"
                startValue="1"
                incrementBy="5"/>

        <createTable tableName="HEX_CONVERSATIONS">

            <column name="ID"
                    type="BIGINT">
                <constraints
                        primaryKey="true"
                        nullable="false"/>
            </column>

            <column name="CONVERSATION_ID"
                    type="VARCHAR(255)">
                <constraints
                        nullable="false"
                        unique="true"/>
            </column>

            <column name="KNOWLEDGE_BASE_ID"
                    type="VARCHAR(255)">
                <constraints
                        nullable="false"/>
            </column>

            <column name="TITLE"
                    type="VARCHAR(255)">
                <constraints
                        nullable="false"/>
            </column>

            <column name="CREATED_AT"
                    type="TIMESTAMP WITH TIME ZONE">
                <constraints
                        nullable="false"/>
            </column>

        </createTable>

        <createIndex
                indexName="IDX_CONVERSATIONS_KNOWLEDGE_BASE_ID"
                tableName="HEX_CONVERSATIONS">

            <column name="KNOWLEDGE_BASE_ID"/>

        </createIndex>

    </changeSet>

</databaseChangeLog>